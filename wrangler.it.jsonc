{
  // Site italien kitcampermodulare.it : mêmes sources que kitamenagement.fr, pages dans public-it/.
  // Cloudflare > Workers > Create > Import a repository : jlanrom/Camperizate, branche kitamenagement,
  // commande de déploiement : npx wrangler deploy --config wrangler.it.jsonc
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "kitcampermodulare",
  "compatibility_date": "2025-09-01",
  "assets": {
    "directory": "./public-it"
  }
}
